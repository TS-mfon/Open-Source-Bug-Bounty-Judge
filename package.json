{
  "name": "open-source-bug-bounty-judge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "contract:lint": "UV_CACHE_DIR=.cache/uv UV_TOOL_DIR=.cache/uv-tools uvx --from genvm-linter genvm-lint check contracts/contribution_review_protocol.py",
    "contract:test": "UV_CACHE_DIR=.cache/uv UV_TOOL_DIR=.cache/uv-tools uvx --from genlayer-test pytest -q contracts/tests/direct",
    "contract:test:integration": "gltest contracts/tests/integration -v -s --network studionet"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@types/three": "^0.185.1",
    "genlayer-js": "^1.1.8",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "viem": "^2.55.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
